<UserControl x:Class="BIA.ToolKit.UserControls.ProjectSelectorUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BIA.ToolKit.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProjectViewModel, IsDesignTimeCreatable=False}"
             d:Width="1280">
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Column 0: Root path + browse -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto" SharedSizeGroup="BrowseButtonColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="RootPathTextBox"
                     Grid.Column="0"
                     Style="{StaticResource MaterialDesignFilledTextBox}"
                     materialDesign:HintAssist.Hint="Projects Parent Path"
                     Text="{Binding RootProjectsPath}"
                     TextWrapping="Wrap"/>
            <Button Grid.Column="1" Margin="5,0"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    ToolTip="Browse..."
                    Click="BrowseRootFolder_Click">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Height="26" Width="26"/>
            </Button>

            <!-- Coachmark: shown only while no project is selected. The zero-height Canvas
                 anchors it right under the Parent Path + Browse row WITHOUT reserving layout
                 space, so it floats over whatever sits below (overlay). The arrow sits in a
                 column sharing its width with the Browse button's column (SharedSizeGroup),
                 so it stays centered under Browse at any window size. IsHitTestVisible=False
                 so it never steals clicks. -->
            <Canvas x:Name="HintCanvas" Grid.Row="1" Grid.ColumnSpan="2"
                    Height="0" IsHitTestVisible="False">
                <Grid Canvas.Top="6" Width="{Binding ActualWidth, ElementName=HintCanvas}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProjectSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto" SharedSizeGroup="BrowseButtonColumn"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Row="0" Grid.Column="1"
                          Data="M 0,8 L 8,0 L 16,8 Z"
                          Fill="{DynamicResource MaterialDesign.Brush.Primary}"
                          Width="16" Height="8" Margin="0,0,0,-1"
                          HorizontalAlignment="Center" Panel.ZIndex="1"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            HorizontalAlignment="Right" MaxWidth="440"
                            CornerRadius="8" BorderThickness="1" Padding="12,10"
                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="HelpCircleOutline" Width="18" Height="18"
                                                     VerticalAlignment="Top" Margin="0,1,10,0"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Select a project to begin" FontWeight="SemiBold"/>
                                <TextBlock Text="Browse to your projects parent folder, then pick a project from the Project Folder list."
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Canvas>
        </Grid>

        <!-- Column 1: Project folder combo + refresh + refresh info -->
        <Grid Grid.Column="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <ComboBox Grid.Column="0"
                      Style="{StaticResource MaterialDesignFilledComboBox}"
                      materialDesign:HintAssist.Hint="Project Folder"
                      ItemsSource="{Binding Projects}"
                      SelectedValue="{Binding Folder}"/>
            <Button Grid.Column="1" Command="{Binding RefreshProjetsListCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    ToolTip="Refresh project folder list" Margin="5,0">
                <materialDesign:PackIcon Kind="Refresh" Height="26" Width="26"/>
            </Button>
            <Button Style="{StaticResource MaterialDesignPaperDarkButton}"
                    Margin="0,5,0,0" Grid.Row="1"
                    IsEnabled="{Binding IsProjectSelected}"
                    Command="{Binding RefreshProjectInformationsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Refresh project informations" VerticalAlignment="Center"/>
                    <materialDesign:PackIcon Margin="5,0,0,0" Kind="CogRefreshOutline" VerticalAlignment="Center" Height="20" Width="20"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Column 2: Read-only project info -->
        <Grid Grid.Column="2" Margin="10,0,0,0" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="0.4*"/>
                </Grid.ColumnDefinitions>
                <TextBox FontSize="12" Grid.Column="0"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         materialDesign:HintAssist.Hint="Company"
                         Text="{Binding CompanyName, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"/>
                <TextBox FontSize="12" Grid.Column="1" Margin="5,0"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         materialDesign:HintAssist.Hint="Project"
                         Text="{Binding Name, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"/>
                <TextBox FontSize="12" Grid.Column="2"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         materialDesign:HintAssist.Hint="Version"
                         Text="{Binding FrameworkVersion, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <TextBox FontSize="12"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         materialDesign:HintAssist.Hint="BIA Front Folders"
                         Text="{Binding BIAFronts, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
